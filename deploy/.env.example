# Copy to .env (never commit .env).
# Domain pointing at this server -> Caddy gets an HTTPS certificate. Without a domain use <server-ip>.sslip.io.
# For a plain-HTTP local test use DOMAIN=:80 and HTTP_PORT=8080.
DOMAIN=demo.example.com
HTTP_PORT=80
HTTPS_PORT=443
# EC2 only: stop the instance after this many minutes without users and with nothing being analysed (0 = never).
# deploy/autostop runs the check every minute; the admin page shows the countdown and has a "Tắt server" button.
AUTOSTOP_IDLE_MIN=30

# App settings (deploy/configure-app.sh writes these; run it again to change them):
# Supabase gallery: Project URL + secret key (Project Settings -> API Keys). Empty = no gallery, in-memory only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# /admin password hash, from configure-app.sh or: python -m webapp.admin hash-password
# Keep the single quotes: the hash contains '$'.
ADMIN_PASSWORD_HASH='scrypt$16384$8$1$replace$with-a-real-hash'
