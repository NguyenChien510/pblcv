# Copy to .env (never commit .env).
# Domain pointing at this server -> Caddy gets an HTTPS certificate. Without a domain use <server-ip>.sslip.io.
# For a plain-HTTP local test use DOMAIN=:80 and HTTP_PORT=8080.
DOMAIN=demo.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Shared login. Hash from:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains '$'.
AUTH_USER=demo
AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'
